{
  "name": "ota-management-desktop",
  "version": "1.0.0",
  "description": "OTA Management Desktop Application - Electron frontend with Python Flask backend",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start-backend": "python3 backend/app.py",
    "dev": "concurrently \"npm run start-backend\" \"wait-on http://localhost:8000 && electron .\"",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux"
  },
  "keywords": [
    "OTA",
    "Firmware",
    "ESP32",
    "Electron",
    "Desktop"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.5.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {},
  "build": {
    "appId": "com.ota.management",
    "productName": "OTA Management",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "front/**/*",
      "config/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "firmware",
        "to": "firmware"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
