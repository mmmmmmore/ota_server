# .gitignore for Electron + Python project

# Node.js / Electron
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Electron build output
dist/
out/
build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
desktop.ini

# Logs
*.log
log/

# SSL Certificates (keep structure but ignore certs)
*.pem
*.key
*.crt
*.csr
*.srl

# Database
*.db
*.sqlite
*.sqlite3

# Environment
.env
.env.local

# Temporary files
tmp/
temp/
*.tmp

# Coverage
coverage/
.nyc_output/

# Testing
.pytest_cache/
